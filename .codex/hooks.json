{
	"description": "Codex adapter for the repository's shared agent hooks.",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/bin/python3 \"$(jj workspace root)/hooks/run.py\"",
						"timeout": 120,
						"statusMessage": "Applying repository policy"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/bin/python3 \"$(jj workspace root)/hooks/run.py\"",
						"timeout": 30,
						"statusMessage": "Applying repository policy"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/usr/bin/python3 \"$(jj workspace root)/hooks/run.py\"",
						"timeout": 30,
						"statusMessage": "Applying repository policy"
					}
				]
			}
		]
	}
}
