{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Canmi CMS",
	"version": "0.1.0",
	"identifier": "app.canmi.cms",
	"build": {
		"beforeBuildCommand": "pnpm run build:web",
		"beforeDevCommand": "pnpm run dev:web",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"center": true,
				"height": 720,
				"hiddenTitle": true,
				"label": "main",
				"title": "CMS",
				"titleBarStyle": "Overlay",
				"transparent": true,
				"visible": false,
				"width": 1280,
				"windowEffects": {
					"effects": ["sidebar"],
					"state": "followsWindowActiveState"
				}
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
