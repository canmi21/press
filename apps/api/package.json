{
	"name": "@canmi/api",
	"private": true,
	"type": "module",
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply api --local --env dev",
		"db:migrate:remote": "wrangler d1 migrations apply api --remote --env=\"\"",
		"types": "wrangler types --env=\"\" --include-runtime=false",
		"dev": "pnpm run db:migrate:local && wrangler dev --env dev",
		"deploy": "pnpm run db:migrate:remote && wrangler deploy --env=\"\"",
		"build": "pnpm run db:migrate:remote && wrangler deploy --dry-run --outdir=dist --env=\"\""
	},
	"dependencies": {
		"@canmi/robots": "workspace:*",
		"@canmi/store": "workspace:*",
		"@canmi/urls": "workspace:*",
		"@sentry/cloudflare": "^10.69.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260730.1",
		"@types/node": "^26.1.2",
		"drizzle-kit": "^0.31.10",
		"miniflare": "4.20260722.1",
		"wrangler": "^4.115.0"
	}
}
