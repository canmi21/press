{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	// Must not exceed what the installed workerd supports, which lags the calendar.
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat"],

	// Read-only here: the API answers questions about assets and never writes one. The bucket
	// is the same one the CDN serves, because a record and the bytes it describes are produced
	// together and should not be able to drift apart.
	"r2_buckets": [
		{
			"binding": "PUBLIC",
			"bucket_name": "public",
		},
	],

	// The port also appears in libs/urls as the development API URL. wrangler cannot read a
	// TypeScript library, so the number is written twice on purpose.
	"dev": {
		"port": 26512,
		"inspector_port": 26513,
	},

	// Development reads data/public directly, the same way apps/cdn does and for the same
	// reason: the local tree is the source of truth. Without this the simulated bucket is empty
	// and every metadata lookup is a 404 until `--remote` reaches the real one, which makes
	// local work depend on something already having been published.
	//
	// Under `env.dev` so a plain deploy never uploads data/public alongside the worker.
	"env": {
		"dev": {
			"assets": {
				"directory": "../../data/public",
				"binding": "ASSETS",
				"run_worker_first": true,
			},
		},
	},

	"observability": { "logs": { "enabled": true } },
	"placement": { "mode": "smart" },
	// Custom domains only; see apps/cdn for the reasoning.
	"workers_dev": false,
	"preview_urls": false,
}
