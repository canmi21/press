# Everything here is reproducible from source: dependencies, build output,
# caches, and generated code. Nothing generated is ever committed.

# Data lives in the tree but never in git. Git holds code; content -- photos, fetched
# favicons, drafts -- lives here and is mirrored to R2 or backed up separately. Only the
# empty skeleton is tracked, so a fresh clone has the directories to put things in.
# See spec/architecture.md; git ignores, sync filters, and backup lists are three
# different sets and are not to be shared.
data/**
!data/**/
!data/**/.gitkeep

# Dependencies
node_modules/

# Build output
build/
dist/
target/
.svelte-kit/

# Caches
.wrangler/
.turbo/
*.tsbuildinfo

# Generated sources
worker-configuration.d.ts

# Test and coverage output
coverage/

# Environment
.env
.env.*
!.env.example

# age private keys. The real one lives in ~/.config/sops/age and never belongs here, but a
# stray copy would otherwise be committed in the clear. secrets.json is deliberately NOT
# ignored -- it is committed encrypted; see spec/toolchain.md.
*.age
keys.txt
age-key*.txt

# OS
.DS_Store
