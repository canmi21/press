# Dependencies, runtime build output, caches, and generated code stay out by default.
# Committed derived records are named explicitly in the data allowlist below.

# CMS runtime state: the run registry, work-item claims and their lock files. Not `data/`,
# because a process id and a progress count are not records anyone would read a diff of.
# See spec/tasks.md.
.cms/

# Bytecode cache for the Python mise tasks. Produced whenever one is imported rather than run.
__pycache__/

# pnpm keeps its content-addressable store in ~/Library/pnpm. A copy appears here only when
# something runs pnpm inside a sandbox that cannot reach the home directory -- a coding agent
# confined to the workspace is the case that produced it -- and pnpm silently falls back to the
# project root. Harmless, never wanted in a diff.
.pnpm-store/

# Build output
build/
# This is build-time source code, not generated output.
!apps/site/src/lib/content/build/
!apps/site/src/lib/content/build/**
dist/
target/
.svelte-kit/
# Compiled from .inlang on every build; settings.json and messages/ are what is authored.
apps/site/src/lib/paraglide/
apps/site/.inlang/cache/
apps/site/.inlang/.meta.json

# data/ holds assets and the records describing them. The bytes stay out of git -- photos,
# derived variants, fonts, a geocoding database -- and are mirrored to R2 or backed up
# separately; the records go in. The empty skeleton is tracked so a fresh clone has the
# directories to put things in. See spec/architecture.md; git ignores, sync filters, and
# backup lists are three different sets and are not to be shared.
data/**
!data/**/
!data/**/.gitkeep
# An allowlist, not exceptions. What `data/` keeps out of git is bytes, not the directory:
# photographs, derived variants, fonts and a geocoding database say nothing in a diff. These
# are records -- builds consume them without the underlying bytes or local tools.
!data/metadata.json
!data/media.yaml
!data/tags.yaml
!data/fonts.json
# Authored, not derived: the licence a person worked out for a package that declared none.
!data/licenses.yaml
!data/tn.yaml
# What has already been announced to the IndexNow participants. Not derived from anything in the
# tree -- it is a record of requests that were made -- so losing it cannot be recomputed, only
# re-sent, which is the one thing that protocol asks us not to do. It has to travel with the
# repository or a fresh clone announces the whole site. See spec/indexing.md.
!data/indexnow.json
# Under data/build/ the test is whether a CI build reads the file. These five are named by the
# site's Vite config or its content build, and a site-only CI job has no Rust toolchain to
# regenerate them. data/build/opengraph.json is absent on purpose: only `cms og` reads it, to
# skip cards it has already drawn, so losing it costs a slow rerun rather than a build. See
# spec/architecture.md.
!data/build/segments.json
!data/build/crates.json
!data/build/repos.json
!data/build/twitter.json
!data/build/licenses.json

# Dependencies
node_modules/

# Caches
.wrangler/
.turbo/
*.tsbuildinfo

# Generated sources
worker-configuration.d.ts

# Test and coverage output
coverage/

# Environment
.env
.env.*
!.env.example
# What makes a checkout an overlay workspace: its slot number, and nothing else. Describes the
# directory it sits in, not the project, so it never travels. See spec/toolchain.md.
mise.local.toml

# age private keys. The real one lives in ~/.config/sops/age and never belongs here, but a
# stray copy would otherwise be committed in the clear. secrets.json is deliberately NOT
# ignored -- it is committed encrypted; see spec/toolchain.md.
*.age
keys.txt
age-key*.txt

# OS
.DS_Store
