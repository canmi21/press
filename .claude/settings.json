{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(jj commit *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/jj-commit.py"
					},
					{
						"type": "command",
						"if": "Bash(jj describe *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/jj-commit.py"
					}
				]
			}
		]
	}
}
