#!/usr/bin/env python3
#MISE description="Work with the separate repositories under repos/: `repos list|check|sync|bump <name>|clone <url>|enable <name>|disable <name>`"
"""Manage the sub-repositories nested under repos/. See spec/architecture/repos.md.

Each directory there is its own repository, ignored by this workspace and cloned into place.
A sub-repo reads this repository's libraries through a git dependency that its own lockfile
pins to a commit, while an override in pnpm-workspace.yaml makes the same declaration resolve
to local source for anyone working inside the workspace. Those two views drift, and most of
this file exists to say so out loud.

  list             what is cloned, where it came from, and which revision it pins
  check            pins, overrides and shared configuration still agree with this workspace
  sync             write the shared formatter configuration into each sub-repo
  bump <name>      re-resolve the pins, then restore local linking
  clone <url>      add a sub-repo and install it
  enable <name>    give this overlay a working copy of a sub-repo the base already has
  disable <name>   drop it again

check is part of `mise run verify` and is a no-op when repos/ holds nothing. enable is the
exception rather than part of setting an overlay up: an overlay takes on a sub-repo only when
it is changing one, the same way it runs only the dev servers it changes.
"""

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
# Subprocesses write straight to the same descriptor, so block-buffered prints would surface
# after output they were meant to introduce.
sys.stdout.reconfigure(line_buffering=True)

# This checkout, which is the base or one of its overlays. Most of what follows is true of
# either; the two commands that are not say so.
ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"
SLOT = int(os.environ.get("WORKSPACE_SLOT", "0"))

# Formatting rules belong to the user, not to a repository, so every sub-repo carries the same
# ones. Copied rather than linked: a symlink is committed as a symlink and dangles in a clone
# of the sub-repo alone, silently, which is the one failure this arrangement cannot afford.
# `.editorconfig` goes everywhere; the other two go where there is something to govern.
SHARED_CONFIG = {
	".editorconfig": None,
	".oxlintrc.json": "package.json",
	"rustfmt.toml": "Cargo.toml",
}

# pnpm writes one of these per git dependency. Parsed by pattern rather than by loading the
# lockfile as YAML: this is the only line shape we need, and the alternative is a dependency
# on a YAML parser for a file pnpm alone writes.
RESOLUTION = re.compile(r"resolution: \{commit: ([0-9a-f]{40}), path: (/[^,]+), repo: ([^,]+), type: git\}")


def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def git(*args: str, cwd: pathlib.Path = ROOT, check: bool = True) -> subprocess.CompletedProcess:
	result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
	if check and result.returncode != 0:
		sys.stderr.write(result.stderr)
		raise fail(f"git {' '.join(args)} failed")
	return result


def jj(*args: str, cwd: pathlib.Path, check: bool = True) -> subprocess.CompletedProcess:
	result = subprocess.run(["jj", *args], cwd=cwd, capture_output=True, text=True)
	if check and result.returncode != 0:
		sys.stderr.write(result.stderr)
		raise fail(f"jj {' '.join(args)} failed")
	return result


def base_root() -> pathlib.Path:
	"""The base checkout. An overlay is `<base>-<slot>`, so its base is its own name less the slot."""
	if SLOT == 0:
		return ROOT
	return ROOT.parent / ROOT.name.rsplit("-", 1)[0]


def cloned(where: pathlib.Path = REPOS) -> list[pathlib.Path]:
	"""Sub-repos actually present. Absent ones are not an error -- a checkout may want none.

	Any directory counts, rather than only one holding a package.json. A sub-repo may be Rust,
	or may be a repository nothing has been written into yet, and both still want the shared
	configuration and still want `check` to notice when they are not a repository at all.
	"""
	if not where.is_dir():
		return []
	return sorted(p for p in where.iterdir() if p.is_dir())


def is_repository(repo: pathlib.Path) -> bool:
	"""Whether this directory carries its own history rather than borrowing the workspace's.

	Worth asking before every git command run inside one: git walks up, so a plain directory
	under repos/ answers about this repository instead, and quietly reports the wrong remote.
	"""
	return (repo / ".git").exists() or (repo / ".jj").exists()


def origin_of(repo: pathlib.Path) -> str:
	if not is_repository(repo):
		return "(not a repository -- nothing is tracking this directory)"
	remote = git("remote", "get-url", "origin", cwd=repo, check=False)
	return remote.stdout.strip() if remote.returncode == 0 else "(no origin)"


def pins(repo: pathlib.Path) -> list[tuple[str, str]]:
	"""(library name, pinned commit) for every git dependency this sub-repo takes on libs/."""
	lock = repo / "pnpm-lock.yaml"
	if not lock.is_file():
		return []
	found = {}
	for commit, path, _ in RESOLUTION.findall(lock.read_text()):
		if path.startswith("/libs/"):
			found[path.removeprefix("/libs/")] = commit
	return sorted(found.items())


def consumed(repo: pathlib.Path) -> list[str]:
	"""Library directories the sub-repo declares a git dependency on, read off package.json."""
	if not (repo / "package.json").is_file():
		return []
	manifest = json.loads((repo / "package.json").read_text())
	names = []
	for specifier in manifest.get("dependencies", {}).values():
		if isinstance(specifier, str) and "#path:/libs/" in specifier:
			names.append(specifier.split("#path:/libs/", 1)[1].split("&", 1)[0])
	return sorted(set(names))


def package_name(library: str) -> str | None:
	manifest = ROOT / "libs" / library / "package.json"
	if not manifest.is_file():
		return None
	return json.loads(manifest.read_text()).get("name")


def overrides() -> set[str]:
	"""Package names pnpm-workspace.yaml redirects. Same reasoning as RESOLUTION above."""
	text = (ROOT / "pnpm-workspace.yaml").read_text()
	block = re.search(r"^overrides:\n((?:[ \t].*\n|\n)*)", text, re.MULTILINE)
	if not block:
		return set()
	return set(re.findall(r"^\s+'([^']+)':", block.group(1), re.MULTILINE))


def tools(config: pathlib.Path) -> dict[str, str]:
	"""The `[tools]` versions a mise config states, by pattern for the reason RESOLUTION gives."""
	if not config.is_file():
		return {}
	block = re.search(r"^\[tools\]\n((?:(?!\[).*\n)*)", config.read_text(), re.MULTILINE)
	if not block:
		return {}
	return dict(re.findall(r'^([A-Za-z][\w.-]*)\s*=\s*"([^"]+)"', block.group(1), re.MULTILINE))


def shared_config_for(repo: pathlib.Path) -> list[str]:
	"""Which shared files this sub-repo has something for."""
	return [name for name, needs in SHARED_CONFIG.items() if needs is None or (repo / needs).is_file()]


def command_list() -> int:
	present = cloned()
	if not present:
		print("repos/ holds no sub-repositories")
		return 0
	for repo in present:
		print(f"{repo.name}  {origin_of(repo)}")
		for library, commit in pins(repo):
			print(f"    libs/{library} pinned at {commit[:12]}")
	return 0


def command_sync() -> int:
	present = cloned()
	if not present:
		print("repos/ holds no sub-repositories")
		return 0
	written = 0
	for repo in present:
		for name in shared_config_for(repo):
			source, target = ROOT / name, repo / name
			if not source.is_file():
				continue
			if target.is_file() and target.read_bytes() == source.read_bytes():
				continue
			shutil.copy2(source, target)
			print(f"{repo.name}: wrote {name}")
			written += 1
	print(f"shared configuration is current ({written} file(s) written)")
	return 0


def check_configuration(repo: pathlib.Path) -> int:
	problems = 0
	for name in shared_config_for(repo):
		source, target = ROOT / name, repo / name
		if not source.is_file():
			continue
		if not target.is_file():
			print(f"{repo.name}: has no {name} -- a lone clone would format by nobody's rules")
			problems += 1
		elif target.read_bytes() != source.read_bytes():
			print(f"{repo.name}: {name} differs from this workspace's")
			problems += 1
	if problems:
		print("    run `mise run repos sync`; edit the workspace's copy if the rule itself should change")

	# Not generated, because a sub-repo may legitimately need a tool this workspace never uses.
	# Where both name one, they name one version. See spec/architecture/repos.md.
	ours, theirs = tools(ROOT / "mise.toml"), tools(repo / "mise.toml")
	for tool in sorted(set(ours) & set(theirs)):
		if ours[tool] != theirs[tool]:
			print(f"{repo.name}: mise.toml pins {tool} at {theirs[tool]}, this workspace at {ours[tool]}")
			problems += 1
	return problems


def command_check() -> int:
	present = cloned()
	if not present:
		return 0

	main = git("rev-parse", "--verify", "--quiet", "HEAD").stdout.strip()
	redirected = overrides()
	problems = 0

	# Reported once rather than per sub-repo: it is a fact about the working copy, and repeating
	# it for each consumer would bury the pins underneath it.
	dirty = git("diff", "--name-only", "--", "libs/").stdout.split()

	for repo in present:
		# A plain directory here is the one state worse than a drifted pin: git ignores it as a
		# sub-repo and it has no history of its own, so whatever is in it is tracked by nothing.
		if not is_repository(repo):
			print(f"{repo.name}: not a repository -- repos/*/ is ignored here, so nothing tracks it")
			print("    clone it, or move it under apps/ if it belongs to this workspace")
			problems += 1

		problems += check_configuration(repo)

		for library in consumed(repo):
			name = package_name(library)
			if name is None:
				print(f"{repo.name}: depends on libs/{library}, which does not exist here")
				problems += 1
				continue
			if name not in redirected:
				print(f"{repo.name}: pnpm-workspace.yaml has no override for {name} --")
				print(f"    add `'{name}': 'workspace:*'` or local edits will not reach it")
				problems += 1
			# A library that names another through the workspace protocol cannot be resolved
			# from outside this repository at all. See spec/architecture/repos.md.
			dependencies = json.loads((ROOT / "libs" / library / "package.json").read_text())
			workspace_deps = [
				k for k, v in dependencies.get("dependencies", {}).items()
				if isinstance(v, str) and v.startswith("workspace:")
			]
			if workspace_deps:
				print(f"{repo.name}: libs/{library} depends on {', '.join(workspace_deps)}")
				print("    through the workspace protocol, so nobody outside this repo can install it")
				problems += 1

		for library, commit in pins(repo):
			if git("merge-base", "--is-ancestor", commit, main, check=False).returncode != 0:
				print(f"{repo.name}: pinned {commit[:12]} for libs/{library} is not in this history")
				print("    it was never pushed, or the revision it named has been rewritten")
				problems += 1
				continue
			changed = git("diff", "--name-only", commit, "--", f"libs/{library}").stdout.split()
			if changed:
				print(f"{repo.name}: libs/{library} has moved since {commit[:12]}")
				for path in changed:
					print(f"    {path}")
				print(f"    run `mise run repos bump {repo.name}` once the change is pushed")
				problems += 1

	if dirty and problems:
		print("libs/ also has uncommitted changes, which nothing outside this checkout can build against:")
		for path in dirty:
			print(f"    {path}")

	if problems == 0:
		print(f"sub-repo pins and configuration agree with this workspace ({len(present)} checked)")
	return 1 if problems else 0


def command_bump(name: str | None) -> int:
	if not name:
		raise fail("give the sub-repo's name: `mise run repos bump foo`")
	repo = REPOS / name
	if not (repo / "package.json").is_file():
		raise fail(f"repos/{name} is not a cloned sub-repository")

	packages = [package_name(library) for library in consumed(repo)]
	packages = [p for p in packages if p]
	if not packages:
		raise fail(f"repos/{name} takes no git dependency on libs/")

	# Resolved the way a contributor would, which is the point: this is what writes the lockfile
	# they install from. Named packages rather than a bare update, so an unrelated dependency
	# does not move in the same step.
	subprocess.run(["pnpm", "update", "--ignore-workspace", *packages], cwd=repo, check=True)

	# The step that cannot be skipped. After the update above the sub-repo holds fetched copies,
	# and a root install reports `Already up to date` without restoring the local links --
	# `--force` included. Removing the tree first is what makes the next install do the work.
	shutil.rmtree(repo / "node_modules", ignore_errors=True)
	subprocess.run(["pnpm", "install"], cwd=ROOT, check=True)

	print(f"\nbumped repos/{name} and restored local linking")
	for library, commit in pins(repo):
		print(f"    libs/{library} now pinned at {commit[:12]}")
	return 0


def command_clone(url: str | None, name: str | None) -> int:
	if not url:
		raise fail("give the repository to clone: `mise run repos clone <url> [name]`")
	name = name or url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")
	target = REPOS / name
	if target.exists():
		raise fail(f"repos/{name} already exists")

	REPOS.mkdir(exist_ok=True)
	# Colocated, like this repository: the sub-repo is worked on with jj too, and the git side
	# is what its remote and its contributors speak.
	subprocess.run(["jj", "git", "clone", "--colocate", url, str(target)], check=True)
	command_sync()
	subprocess.run(["pnpm", "install"], cwd=ROOT, check=True)

	print(f"\ncloned into repos/{name}")
	print("next: add an override per library it consumes, then `mise run repos check`")
	return 0


def command_enable(name: str | None) -> int:
	if not name:
		raise fail("give the sub-repo's name: `mise run repos enable foo`")
	if SLOT == 0:
		raise fail("the base already holds the sub-repos; enable is for an overlay")

	source = base_root() / "repos" / name
	if not is_repository(source):
		raise fail(f"the base has no sub-repository at repos/{name} -- clone it there first")
	target = REPOS / name
	if target.exists():
		raise fail(f"repos/{name} already exists in this overlay")

	# The same mechanism this repository uses for overlays, one level down: one sub-repo, one
	# change graph, a working copy per overlay that is actually changing it.
	# On trunk, stated rather than defaulted: without a revision jj starts the new working copy
	# on an empty change off the root, and the overlay gets a directory with nothing in it.
	REPOS.mkdir(exist_ok=True)
	jj("workspace", "add", "--name", ROOT.name, "--revision", "trunk()", str(target), cwd=source)
	command_sync()
	subprocess.run(["pnpm", "install"], cwd=ROOT, check=True)
	print(f"\nenabled repos/{name} in {ROOT.name}")
	return 0


def command_disable(name: str | None) -> int:
	if not name:
		raise fail("give the sub-repo's name: `mise run repos disable foo`")
	if SLOT == 0:
		raise fail("the base's sub-repos are not enabled, they are cloned; disable is for an overlay")

	source = base_root() / "repos" / name
	target = REPOS / name
	if not target.is_dir():
		raise fail(f"repos/{name} is not enabled in this overlay")

	# The sub-repo's history does not travel with this repository's, so work left here would go
	# with the directory and `jj log` in the workspace would never have shown it.
	held = jj(
		"log", "--no-graph", "--ignore-working-copy",
		"-r", f"::{ROOT.name}@ ~ ::trunk() ~ empty()",
		"-T", 'change_id.short() ++ " " ++ description.first_line() ++ "\\n"',
		cwd=source, check=False,
	)
	if held.returncode == 0 and held.stdout.strip():
		raise fail(
			f"repos/{name} still holds work its trunk does not cover:\n{held.stdout.strip()}\n"
			"Finish or abandon it in the sub-repo, then disable."
		)

	jj("workspace", "forget", ROOT.name, cwd=source)
	shutil.rmtree(target)
	print(f"disabled repos/{name} in {ROOT.name}")
	return 0


def main(argv: list[str]) -> int:
	action = argv[0] if argv else None
	rest = argv[1:]
	first = rest[0] if rest else None
	if action == "list":
		return command_list()
	if action == "check":
		return command_check()
	if action == "sync":
		return command_sync()
	if action == "bump":
		return command_bump(first)
	if action == "clone":
		return command_clone(first, rest[1] if len(rest) > 1 else None)
	if action == "enable":
		return command_enable(first)
	if action == "disable":
		return command_disable(first)
	raise fail("usage: repos list | check | sync | bump <name> | clone <url> [name] | enable <name> | disable <name>")


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
