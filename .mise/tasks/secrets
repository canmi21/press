#!/usr/bin/env python3
#MISE description="Refuse to let a plaintext secrets file exist"
"""Check that every file .sops.yaml claims is actually encrypted.

The failure this prevents is one-way. A secret committed in plaintext is on the remote, in
every clone, and in the reflog; rotating the credential is the only real remedy. Everything
else in `verify` catches something reversible, so this one runs first.

Detection is the presence of a `sops` block plus `ENC[` on the values, which is exactly what
sops writes and what mise requires to decrypt. That also catches the subtler half-broken
state: sops leaves an empty string untouched, and mise then refuses the whole file because a
value has no ENC prefix, so a placeholder written as "" looks encrypted while being neither
usable nor safe.
"""

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
RULES = ROOT / ".sops.yaml"


def guarded_patterns() -> list[re.Pattern[str]]:
	"""path_regex entries from .sops.yaml, read without a yaml dependency."""
	if not RULES.is_file():
		return []
	found = re.findall(r"path_regex:\s*(\S+)", RULES.read_text())
	return [re.compile(pattern) for pattern in found]


def unencrypted(path: pathlib.Path) -> str | None:
	"""Why this file is not safe to commit, or None if it is."""
	try:
		data = json.loads(path.read_text())
	except (OSError, json.JSONDecodeError):
		return "not readable as JSON, so it is neither valid plaintext nor valid sops output"

	if "sops" not in data:
		return "no sops block: this is plaintext"

	bare = [
		key
		for key, value in data.items()
		if key != "sops" and isinstance(value, str) and not value.startswith("ENC[")
	]
	if bare:
		return f"values are not encrypted: {', '.join(sorted(bare))}"
	return None


def main() -> int:
	patterns = guarded_patterns()
	if not patterns:
		print("no .sops.yaml rules to enforce")
		return 0

	problems = []
	checked = 0
	for path in ROOT.rglob("*"):
		if not path.is_file() or {"node_modules", ".jj", ".git", "target"} & set(path.parts):
			continue
		relative = str(path.relative_to(ROOT))
		if not any(pattern.search(relative) for pattern in patterns):
			continue
		checked += 1
		if reason := unencrypted(path):
			problems.append(f"{relative}: {reason}")

	if problems:
		print("Plaintext secrets found:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		print(
			"\nEncrypt with `sops encrypt -i <file>` before committing. If a real credential was "
			"ever written here in plaintext, rotate it -- removing the file does not remove it "
			"from history.",
			file=sys.stderr,
		)
		return 1

	print(f"secrets OK: {checked} file(s) encrypted")
	return 0


if __name__ == "__main__":
	sys.exit(main())
