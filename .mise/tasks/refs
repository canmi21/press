#!/usr/bin/env python3
#MISE description="Check that references resolve and that URLs live in one place"
"""Validate how this repo refers to things: to its own files, and to hosts.

Three checks, all chosen because they are objective rather than stylistic:

1. A markdown link in a doc points at a file that exists.
2. A `spec/*.md` cited from code exists.
3. No URL the running system resolves is written outside `libs/urls`.

The first two break silently on rename -- nothing fails, the reader just follows a dead path.
The third is the enforcement half of the single-source rule in spec/architecture.md, which was
prose-only until this check existed, and prose-only rules are followed until the first time
somebody is in a hurry.

Deliberately NOT checked: path-shaped strings in prose. The rules use invented names as
examples on purpose (`apps/r2`, `user-profile.ts`, `libs/canvas` as a name that was rejected),
and a check that flags those would be wrong far more often than right. Illustrations stay in
inline code; real references are markdown links, which is what makes them checkable.

Also not flagged as URLs: comments, markdown links, `$schema` keys, and JSON-LD `@context`
values. The first two are citations that no software resolves. `$schema` has to be a URL
precisely because these tools are installed through mise and have no `node_modules` to point
at -- see spec/toolchain.md. `@context` is a namespace identifier, like an xmlns.

Run with --json to emit the pair graph instead of validating.
"""

import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
DOC_GLOBS = ("spec/*.md", "CLAUDE.md")
CODE_SUFFIXES = {
	".ts",
	".js",
	".mjs",
	".svelte",
	".html",
	".py",
	".css",
	".toml",
	".json",
	".jsonc",
	".yaml",
	".yml",
}
# Directories whose files are records or prose rather than code, plus the lockfile --
# see the code_files docstring and spec/architecture.md for each exemption's reason.
SKIP_DIRS = {"data", "contents"}
SKIP_FILES = {"pnpm-lock.yaml"}

MD_LINK = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
SPEC_REF = re.compile(r"spec/[a-z0-9-]+\.md")
URL = re.compile(r"https?://[^\s\"'`)\],;]+")
COMMENT = re.compile(r"^\s*(//|#|\*|/\*|<!--)")
URL_HOME = "libs/urls/"
# `$schema` keys have to be URLs because mise-installed tools have no node_modules to point
# at (spec/toolchain.md). JSON-LD's `@context` is a namespace identifier like an xmlns:
# changing it changes what the document means, not where anything points.
URL_EXEMPT = ('"$schema"', "'@context'", '"@context"')
# Names RFC 2606 reserves so they can never resolve to anything. A URL on one of these is a
# placeholder -- for an API that demands an absolute URL, or for a value a test needs to be
# rejected -- and by definition never an endpoint, so it cannot be what this check looks for.
# Exempting them by rule rather than case by case is what keeps this from collecting
# exceptions.
URL_UNRESOLVABLE = re.compile(
	r"https?://(?:[^/\s]*\.)?(?:test|example|invalid|localhost)(?:[/:?#]|$)"
	r"|https?://(?:[^/\s]*\.)?example\.(?:com|net|org)(?:[/:?#]|$)"
)
# An XML namespace is an identifier that the specification explicitly does not require to be
# dereferenceable, and changing one changes the document's meaning rather than where it points.
# Treating these as endpoints would demand they be declared alongside hosts we actually call.
XML_NAMESPACE = re.compile(r"xmlns(?::[\w-]+)?\s*=|schemaLocation")


def docs() -> list[pathlib.Path]:
	found: list[pathlib.Path] = []
	for pattern in DOC_GLOBS:
		found.extend(sorted(ROOT.glob(pattern)))
	return found


def code_files() -> list[pathlib.Path]:
	"""Files whose URLs something other than a reader would resolve.

	The candidate set comes from git -- tracked files plus new ones not yet ignored -- because
	`.gitignore` is already the one home of "this is build output, not code". An earlier version
	kept its own directory denylist here and skipped any path segment named `build`, which
	silently exempted `apps/site/src/lib/content/build/`: a source directory that merely shares
	a name with output. A second list of what is code can only ever drift from the first.

	`contents/` is excluded whatever the extension. A translation sidecar is YAML by format
	and prose by nature: the links in it are the ones the author wrote in the article, carried
	across by the translator. Asking those to live in libs/urls would be asking an article not
	to cite anything. `data/` holds curated records, not code, and is excluded the same way.
	"""
	listing = subprocess.run(
		["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
		capture_output=True,
		text=True,
		check=True,
	)
	return [
		path
		for name in listing.stdout.split("\0")
		if name
		for path in [ROOT / name]
		if path.name not in SKIP_FILES
		and path.suffix in CODE_SUFFIXES
		and not SKIP_DIRS & set(pathlib.PurePath(name).parts)
	]


def read(path: pathlib.Path) -> str:
	try:
		return path.read_text()
	except (OSError, UnicodeDecodeError):
		return ""


def without_code(text: str) -> str:
	"""Blank out fenced blocks and inline code, keeping line structure intact.

	A doc that documents markdown syntax writes things like `![](cid.ext)` inside backticks.
	Those are examples of a link, not links, and reading them as targets makes the spec unable
	to describe the very format this repository uses without tripping its own gate.
	"""
	text = FENCE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
	return INLINE_CODE.sub(lambda m: " " * len(m.group(0)), text)


FENCE = re.compile(r"```.*?```", re.S)
INLINE_CODE = re.compile(r"`[^`\n]+`")


def dead_doc_links() -> list[str]:
	dead = []
	for doc in docs():
		for match in MD_LINK.finditer(without_code(read(doc))):
			target = match.group(1)
			if target.startswith(("http://", "https://", "#", "mailto:")):
				continue
			if not (doc.parent / target.split("#")[0]).exists():
				dead.append(f"{doc.relative_to(ROOT)} -> {target}")
	return dead


def stray_urls() -> list[str]:
	"""URLs written outside libs/urls that something other than a reader would resolve."""
	stray = []
	for path in code_files():
		rel = str(path.relative_to(ROOT))
		if rel.startswith(URL_HOME):
			continue
		for number, line in enumerate(read(path).splitlines(), 1):
			if COMMENT.match(line) or any(token in line for token in URL_EXEMPT):
				continue
			if XML_NAMESPACE.search(line):
				continue
			for match in URL.finditer(line):
				if URL_UNRESOLVABLE.match(match.group(0)):
					continue
				stray.append(f"{rel}:{number} {match.group(0)}")
	return stray


def pair_graph() -> dict[str, list[str]]:
	"""spec file -> the code files that cite it."""
	graph: dict[str, list[str]] = {}
	for path in code_files():
		rel = str(path.relative_to(ROOT))
		for spec in sorted(set(SPEC_REF.findall(read(path)))):
			graph.setdefault(spec, []).append(rel)
	return graph


def main() -> int:
	graph = pair_graph()

	if "--json" in sys.argv:
		print(json.dumps(graph))
		return 0

	problems = [f"dead link: {d}" for d in dead_doc_links()]
	problems += [
		f"missing spec cited by {cited}: {spec}"
		for spec, cited in sorted(graph.items())
		if not (ROOT / spec).exists()
		for cited in [", ".join(cited)]
	]
	problems += [
		f"URL outside {URL_HOME}: {u}  (declare it there, or make it a comment if it is a"
		f" citation -- see spec/architecture.md)"
		for u in stray_urls()
	]

	if problems:
		print("Reference check failed:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1

	linked = sum(len(v) for v in graph.values())
	print(f"references OK: {len(docs())} docs, {linked} code -> spec citations, URLs single-sourced")
	return 0


if __name__ == "__main__":
	sys.exit(main())
