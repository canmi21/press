#!/usr/bin/env python3
#MISE description="Build or check web-font chunks declared in data/fonts.json"
"""Build web-font chunks without turning retained full faces into a requirement.

The manifest makes the two independent roles of a full face visible: a disposable pipeline
input and, for the one family that needs it, a runtime dependency. See spec/architecture.md.
"""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Any

ROOT = pathlib.Path(__file__).resolve().parents[2]
MANIFEST = ROOT / "data/fonts.json"
RUNNER = pathlib.Path(__file__).with_name("font-split.mjs")
HASHED_CHUNK = re.compile(r"[0-9a-f]{32}\.woff2")
FONT_URL = re.compile(r"url\(['\"]?[^)'\"]*/([^/'\"]+\.woff2)['\"]?\)")
SPLITTER_COMMENT = re.compile(r"/\* Generated By cn-font-split@.*?\*/\s*", re.DOTALL)

# These are the stable writing-system groupings used by Google Fonts CSS. They deliberately
# live in the pipeline rather than each family record: a subset name has one meaning, while
# the manifest only chooses which named groups a face publishes.
SUBSET_RANGES = {
	"latin": (
		"U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,"
		"U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,"
		"U+FEFF,U+FFFD"
	),
	"latin-ext": (
		"U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,"
		"U+2C60-2C7F,U+A720-A7FF"
	),
	"vietnamese": (
		"U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,"
		"U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB"
	),
	"greek": "U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF",
	"greek-ext": "U+1F00-1FFF",
	"cyrillic": "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116",
	"cyrillic-ext": (
		"U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F"
	),
}


def load_manifest() -> dict[str, Any]:
	try:
		return json.loads(MANIFEST.read_text())
	except (OSError, json.JSONDecodeError) as error:
		raise ValueError(f"could not read {MANIFEST.relative_to(ROOT)}: {error}") from error


def repo_path(value: str) -> pathlib.Path:
	path = (ROOT / value).resolve()
	if ROOT not in path.parents:
		raise ValueError(f"path leaves the repository: {value}")
	return path


def css_chunks(path: pathlib.Path) -> set[str]:
	return set(FONT_URL.findall(path.read_text()))


def named_chunks(family: dict[str, Any]) -> set[str]:
	return {
		f"{face['stem']}-{subset}.woff2"
		for face in family["faces"]
		for subset in face["subsets"]
	}


def validate_family(family: dict[str, Any], require_published: bool = True) -> list[str]:
	problems: list[str] = []
	label = family.get("id", "<unnamed>")
	strategy = family.get("strategy")
	if strategy not in {"named-subsets", "frequency-chunks"}:
		problems.append(f"{label}: unknown strategy {strategy!r}")
		return problems

	chunks = family.get("chunks")
	if chunks not in {"prebuilt", "generated"}:
		problems.append(f"{label}: chunks must be prebuilt or generated")

	output = repo_path(family["output"])
	stylesheet = repo_path(family["stylesheet"])
	if require_published and not output.is_dir():
		problems.append(f"{label}: output directory is missing: {output.relative_to(ROOT)}")
	if require_published and not stylesheet.is_file():
		problems.append(f"{label}: stylesheet is missing: {stylesheet.relative_to(ROOT)}")

	for face in family.get("faces", []):
		input_name = face.get("input")
		if chunks == "generated" and not input_name:
			problems.append(f"{label}: a generated face has no pipeline input")
		if input_name and not repo_path(input_name).is_file():
			problems.append(f"{label}: pipeline input is missing: {input_name}")
		if strategy == "named-subsets":
			for subset in face.get("subsets", []):
				if subset not in SUBSET_RANGES:
					problems.append(f"{label}: unknown named subset {subset!r}")

	runtime = family.get("runtimeInput")
	if runtime:
		for key in ("path", "consumer"):
			value = runtime.get(key)
			if not value or not repo_path(value).is_file():
				problems.append(f"{label}: runtime {key} is missing: {value}")

	if output.is_dir() and stylesheet.is_file():
		files = {path.name for path in output.glob("*.woff2")}
		references = css_chunks(stylesheet)
		if files != references:
			missing = sorted(files - references)
			dangling = sorted(references - files)
			if missing:
				problems.append(f"{label}: chunks absent from CSS: {', '.join(missing)}")
			if dangling:
				problems.append(f"{label}: CSS references absent chunks: {', '.join(dangling)}")
		if strategy == "named-subsets" and files != named_chunks(family):
			problems.append(f"{label}: published names do not match its faces and subsets")
		if strategy == "frequency-chunks":
			bad = sorted(name for name in files if not HASHED_CHUNK.fullmatch(name))
			if bad:
				problems.append(f"{label}: frequency chunks are not content-hashed: {', '.join(bad)}")
			wrong_hash = sorted(
				path.name
				for path in output.glob("*.woff2")
				# cn-font-split's 32-character cache key is MD5 identity, not a security digest.
				if HASHED_CHUNK.fullmatch(path.name)
				and hashlib.md5(path.read_bytes(), usedforsecurity=False).hexdigest() != path.stem
			)
			if wrong_hash:
				problems.append(
					f"{label}: chunk names do not match their content: {', '.join(wrong_hash)}"
				)

	return problems


def check(manifest: dict[str, Any]) -> int:
	families = manifest.get("families", [])
	ids = [family.get("id") for family in families]
	problems = []
	if len(ids) != len(set(ids)):
		problems.append("font family ids are not unique")
	for family in families:
		problems.extend(validate_family(family))
	if problems:
		print("Font manifest problems:", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1
	probe_splitter(families)
	print(f"fonts OK: {len(families)} families")
	return 0


def codepoints(unicode_range: str) -> list[int]:
	points: list[int] = []
	for item in unicode_range.split(","):
		bounds = item.removeprefix("U+").split("-")
		start = int(bounds[0], 16)
		end = int(bounds[-1], 16)
		points.extend(range(start, end + 1))
	return points


def split(config: dict[str, Any], directory: pathlib.Path) -> None:
	config_path = directory / "config.json"
	config_path.write_text(json.dumps(config))
	subprocess.run(
		["node", str(RUNNER), str(config_path)],
		cwd=ROOT,
		check=True,
	)


def probe_splitter(families: list[dict[str, Any]]) -> None:
	generated = next((family for family in families if family["chunks"] == "generated"), None)
	if generated is None:
		return
	with tempfile.TemporaryDirectory(prefix=".font-split-check.") as temp:
		directory = pathlib.Path(temp)
		config = {
			"input": str(repo_path(generated["faces"][0]["input"])),
			"outDir": str(directory),
			"subsets": [[0x41]],
			"subsetRemainChars": False,
			"autoSubset": False,
			"fontFeature": True,
			"renameOutputFont": "probe.[ext]",
			"testHtml": False,
			"reporter": False,
			"silent": True,
		}
		split(config, directory)
		outputs = list(directory.glob("*.woff2"))
		if len(outputs) != 1 or outputs[0].stat().st_size == 0:
			raise RuntimeError("cn-font-split smoke slice did not produce one non-empty WOFF2 file")


def generated_css(directory: pathlib.Path) -> str:
	stylesheets = list(directory.glob("*.css"))
	if len(stylesheets) != 1:
		raise RuntimeError(f"cn-font-split produced {len(stylesheets)} stylesheets, expected one")
	return stylesheets[0].read_text()


def normalize_css(css: str, family_id: str) -> str:
	return re.sub(
		r"url\((['\"]?)(?:\./)?([^)'\"]+\.woff2)\1\)",
		rf"url(\1__CDN_URL__/fonts/{family_id}/\2\1)",
		SPLITTER_COMMENT.sub("", css),
	)


def stylesheet_header(path: pathlib.Path) -> str:
	if not path.is_file():
		return ""
	text = path.read_text()
	start = text.find("@font-face")
	header = text[:start] if start >= 0 else text.rstrip() + "\n\n"
	return SPLITTER_COMMENT.sub("", header)


def build_frequency(family: dict[str, Any], stage: pathlib.Path) -> str:
	face = family["faces"][0]
	config = {
		"input": str(repo_path(face["input"])),
		"outDir": str(stage),
		"css": {
			"fontFamily": family["family"],
			"fontWeight": face["weight"],
			"fontStyle": face["style"],
			"fontDisplay": "swap",
			"localFamily": [family["family"]],
			"commentUnicodes": False,
			"compress": False,
		},
		"renameOutputFont": "[hash:32].[ext]",
		"testHtml": False,
		"reporter": False,
		"silent": True,
	}
	split(config, stage)
	return normalize_css(generated_css(stage), family["id"])


def face_css(family: dict[str, Any], face: dict[str, Any], subset: str) -> str:
	filename = f"{face['stem']}-{subset}.woff2"
	return f"""@font-face {{
	font-family: '{family['family']}';
	font-style: {face['style']};
	font-weight: {face['weight']};
	font-display: swap;
	src: url('__CDN_URL__/fonts/{family['id']}/{filename}') format('woff2');
	unicode-range: {SUBSET_RANGES[subset]};
}}"""


def build_named(family: dict[str, Any], stage: pathlib.Path) -> str:
	rules = []
	for face in family["faces"]:
		for subset in face["subsets"]:
			part = stage / f"{face['stem']}-{subset}"
			part.mkdir()
			filename = f"{face['stem']}-{subset}"
			config = {
				"input": str(repo_path(face["input"])),
				"outDir": str(part),
				"subsets": [codepoints(SUBSET_RANGES[subset])],
				"subsetRemainChars": False,
				"autoSubset": False,
				"fontFeature": True,
				"renameOutputFont": f"{filename}.[ext]",
				"testHtml": False,
				"reporter": False,
				"silent": True,
			}
			split(config, part)
			fonts = list(part.glob("*.woff2"))
			if len(fonts) != 1:
				raise RuntimeError(f"{filename}: cn-font-split produced {len(fonts)} chunks")
			shutil.move(fonts[0], stage / f"{filename}.woff2")
			rules.append(face_css(family, face, subset))
	return "\n\n".join(rules) + "\n"


def publish(family: dict[str, Any], stage: pathlib.Path, css: str) -> None:
	output = repo_path(family["output"])
	stylesheet = repo_path(family["stylesheet"])
	for path in stage.iterdir():
		if path.is_dir() or path.suffix != ".woff2":
			if path.is_dir():
				shutil.rmtree(path)
			else:
				path.unlink()
	backup = output.with_name(f".{output.name}.previous")
	if backup.exists():
		raise RuntimeError(f"refusing to replace output while backup exists: {backup}")
	had_output = output.exists()
	if had_output:
		os.replace(output, backup)
	try:
		os.replace(stage, output)
		stylesheet.write_text(stylesheet_header(stylesheet) + css)
	except Exception:
		if output.exists():
			shutil.rmtree(output)
		if had_output:
			os.replace(backup, output)
		raise
	if had_output:
		shutil.rmtree(backup)


def build(family: dict[str, Any]) -> None:
	if family["chunks"] == "prebuilt":
		print(f"{family['id']}: prebuilt chunks are complete; no pipeline input is retained")
		return
	output = repo_path(family["output"])
	with tempfile.TemporaryDirectory(prefix=f".{family['id']}.", dir=output.parent) as temp:
		stage = pathlib.Path(temp) / family["id"]
		stage.mkdir()
		if family["strategy"] == "frequency-chunks":
			css = build_frequency(family, stage)
		else:
			css = build_named(family, stage)
		# TemporaryDirectory no longer owns this path after the atomic move.
		publish(family, stage, css)
	print(f"{family['id']}: published {len(list(output.glob('*.woff2')))} chunks")


def main() -> int:
	try:
		manifest = load_manifest()
		if sys.argv[1:] == ["--check"]:
			return check(manifest)
		if len(sys.argv) != 2:
			print("usage: mise run fonts --check | <family> | --all", file=sys.stderr)
			return 2
		families = {family["id"]: family for family in manifest["families"]}
		selected = list(families.values()) if sys.argv[1] == "--all" else [families[sys.argv[1]]]
		for family in selected:
			problems = validate_family(family, require_published=family["chunks"] == "prebuilt")
			if problems:
				raise ValueError("; ".join(problems))
			build(family)
		return check(manifest)
	except (KeyError, OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
		print(f"fonts: {error}", file=sys.stderr)
		return 1


if __name__ == "__main__":
	sys.exit(main())
