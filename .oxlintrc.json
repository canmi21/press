{
	// Schema is fetched over HTTP rather than from ./node_modules, because oxlint is
	// installed through mise (see mise.toml) and there is no local install to point at.
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "import", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn",
		// style, pedantic, and nursery stay off. style overlaps oxfmt outright; the other
		// two are opinion rather than defect. See spec/lint-format.md.
		"style": "off",
		"pedantic": "off",
		"nursery": "off"
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/node_modules/**",
		"**/.svelte-kit/**",
		"**/.wrangler/**",
		"**/worker-configuration.d.ts",
		"data/**"
	],
	"rules": {
		// Formatting belongs to oxfmt, so the linter does not police it. Verified: oxfmt
		// rewrites U+00A0 to a plain space on its own, which makes this rule pure
		// duplication. See spec/lint-format.md.
		"no-irregular-whitespace": "off",

		// Paraglide exports each message under its literal dotted key, so reading one is a
		// computed namespace access this rule cannot follow. The check it performs is already
		// done, and done better, by the compiler: verified that `m['notice.polised']` fails
		// type checking with "Property 'notice.polised' does not exist ... Did you mean
		// 'notice.polished'?", naming the typo the linter could only say it was unable to
		// validate. Same duplication argument as the rules above. See spec/locale.md for why
		// the keys are dotted and why the named-import spelling is not an option.
		"import/namespace": "off",

		// Side-effect imports are load-bearing here: `import '@canmi/tokens/colors.css'`
		// is how every app pulls in styles. Verified: with this rule on, oxlint reports
		// each one of them. Turning it off is not a preference, it is required by the
		// Vite + Tailwind setup.
		"import/no-unassigned-import": "off",

		// Redundant rather than wrong. Verified: with this off, `import {} from './x'`
		// is still caught by import/no-empty-named-blocks, which is active. Two rules
		// reporting one defect is the same duplication problem as lint overlapping fmt,
		// so the narrower one stays off. See spec/lint-format.md.
		"unicorn/require-module-specifiers": "off"
	},
	"env": {
		"builtin": true
	}
}
